# Copie este arquivo para .env e preencha com os seus dados.

# Banco de dados (troque SENHA pela senha do seu PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:SENHA@localhost:5432/erp_confeitaria
DATABASE_URL_SYNC=postgresql://postgres:SENHA@localhost:5432/erp_confeitaria

# Servidor
HOST=0.0.0.0
PORT=8000
RELOAD=true
WORKERS=1

# CORS - origens permitidas (separar por virgula)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Seguranca - use uma chave aleatoria longa, nao uma senha pessoal
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ambiente
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backup
BACKUP_DIR=./backups/json
BACKUP_SCHEDULE=0 2 * * *

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Nome da empresa
EMPRESA_NOME=Dom Cookies
